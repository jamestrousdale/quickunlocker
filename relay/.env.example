# Hostname the phone and PC use. Add a Pi-hole Local DNS record pointing it at the Pi.
UNLOCK_HOST=unlock.home.example.com
# Only needed if HTTPS_PORT isn't 443, e.g. https://unlock.home.example.com:8443
# UNLOCK_ORIGIN=
# HTTPS_PORT=443

# Cloudflare API token with Zone:DNS:Edit on your domain (used only for the DNS-01 cert challenge)
CF_DNS_API_TOKEN=
ACME_EMAIL=you@example.com

LAN_CIDR=192.168.1.0/24

# Optional subnet broadcast IPv4 address when the Pi has multiple interfaces.
# WAKE_BROADCAST=192.168.1.255

# With a separate trusted HTTPS gateway, set these to its public hostname and origin.
# UNLOCK_RP_ID=unlock.home.example.com
# UNLOCK_ORIGIN=https://unlock.home.example.com
